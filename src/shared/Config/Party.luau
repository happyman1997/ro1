--!strict
--[[
	Группы (пати) для совместных рейдов. Читают сервер (PartyService)
	и клиент (PartyController, интерфейс).
]]

return table.freeze({
	-- Игроков в группе. Не больше половины участков на сервере (сейчас их 4),
	-- иначе одна группа займёт весь сервер и драться будет не с кем.
	MaxSize = 2,
	InviteTtl = 30, -- секунд живёт приглашение
	-- Секунд после выхода из группы бывшие союзники ещё «свои»: нельзя выйти
	-- и тут же выстрелить в спину или взломать кассу, пока стоишь у неё.
	LeaveGrace = 5,
})
