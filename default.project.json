{
  "name": "ro1",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "ServerStorage": {
      "Restaurants": {
        "$path": "scene/Restaurants"
      },
      "Weapons": {
        "$path": "scene/Weapons"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "TextChatService": {
      "$properties": {
        "ChatVersion": "TextChatService"
      }
    },
    "Workspace": {
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Locked": true,
          "Size": [512, 2, 512],
          "CFrame": {
            "CFrame": {
              "position": [0, -1, 0],
              "orientation": [[1, 0, 0], [0, 1, 0], [0, 0, 1]]
            }
          },
          "Color": [0.36, 0.55, 0.29],
          "Material": "Grass",
          "TopSurface": "Smooth",
          "BottomSurface": "Smooth"
        }
      },
      "LobbySpawn": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "Size": [8, 1, 8],
          "CFrame": {
            "CFrame": {
              "position": [0, 0.5, 70],
              "orientation": [[1, 0, 0], [0, 1, 0], [0, 0, 1]]
            }
          },
          "Neutral": true,
          "Duration": 3
        }
      },
      "Plots": {
        "$path": "scene/Plots"
      }
    }
  }
}
